{
  "name": "ahg_offer",
  "language": "en",
  "category": "MARKETING",
  "parameter_format": "NAMED",
  "components": [
    {
      "type": "HEADER",
      "format": "TEXT",
      "text": "Grow your business online"
    },
    {
      "type": "BODY",
      "text": "Hi {{customer_name}}! 🚀\n\nAHG53 Agency is ready to serve businesses in {{country}} with:\n• Business websites & e-commerce stores\n• Android & iOS mobile apps\n• White-label web & marketing services for agencies\n\n{{offer_details}}\n\nBest price, best work — reply to get your free, no-obligation quote.",
      "example": {
        "body_text_named_params": [
          {
            "param_name": "customer_name",
            "example": "Aisha"
          },
          {
            "param_name": "country",
            "example": "UAE"
          },
          {
            "param_name": "offer_details",
            "example": "This month: free logo design with every new website."
          }
        ]
      }
    },
    {
      "type": "FOOTER",
      "text": "Reply STOP to unsubscribe"
    },
    {
      "type": "BUTTONS",
      "buttons": [
        {
          "type": "URL",
          "text": "View our work",
          "url": "{{APP_URL}}/r/{{1}}",
          "example": [
            "{{APP_URL}}/r/a1b2c3d4e5f6"
          ]
        }
      ]
    }
  ]
}
