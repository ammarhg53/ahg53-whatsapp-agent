    {
      "type": "HEADER",
      "format": "IMAGE",
      "example": {
        "header_handle": [
          "{{EXAMPLE_IMAGE_HANDLE}}"
        ]
      }
    },
    {
      "type": "BODY",
      "text": "Hi {{customer_name}}! 🎬\n\nHumne Instagram par nayi reel daali hai: {{reel_topic}}.\n\nNeeche tap karke dekhein, aur websites, apps aur automation tips ke liye AHG53 Agency ko follow karein.",
      "example": {
        "body_text_named_params": [
          {
            "param_name": "customer_name",
            "example": "Aisha"
          },
          {
            "param_name": "reel_topic",
            "example": "5 signs your business needs a new website"
          }
        ]
      }
    },
    {
      "type": "FOOTER",
      "text": "Band karne ke liye STOP likhein"
    },
    {
      "type": "BUTTONS",
      "buttons": [
        {
          "type": "URL",
          "text": "Reel dekhein",
          "url": "{{APP_URL}}/r/{{1}}",
          "example": [
            "{{APP_URL}}/r/a1b2c3d4e5f6"
          ]
        }
      ]
    }
  ]
}
