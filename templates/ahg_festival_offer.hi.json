{
  "name": "ahg_festival_offer",
  "language": "hi",
  "category": "MARKETING",
  "parameter_format": "NAMED",
  "components": [
    {
      "type": "HEADER",
      "format": "IMAGE",
      "example": {
        "header_handle": [
          "{{EXAMPLE_IMAGE_HANDLE}}"
        ]
      }
    },
    {
      "type": "BODY",
      "text": "Hi {{customer_name}}! 🎉\n\nAHG53 Agency ki taraf se {{festival_name}} ki dher saari shubhkamnayein!\n\n{{offer_details}}\n\nYeh offer {{valid_till}} tak valid hai. Claim karne ke liye reply karein.",
      "example": {
        "body_text_named_params": [
          {
            "param_name": "customer_name",
            "example": "Aisha"
          },
          {
            "param_name": "festival_name",
            "example": "Diwali"
          },
          {
            "param_name": "offer_details",
            "example": "20% off on all new websites and apps."
          },
          {
            "param_name": "valid_till",
            "example": "31 October"
          }
        ]
      }
    },
    {
      "type": "FOOTER",
      "text": "Band karne ke liye STOP likhein"
    },
    {
      "type": "BUTTONS",
      "buttons": [
        {
          "type": "URL",
          "text": "Offer dekhein",
          "url": "{{APP_URL}}/r/{{1}}",
          "example": [
            "{{APP_URL}}/r/a1b2c3d4e5f6"
          ]
        }
      ]
    }
  ]
}
