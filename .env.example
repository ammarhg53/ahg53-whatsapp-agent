# ---------- App
# Public URL where this app is deployed on Vercel (no trailing slash). Used for
# click-tracking links (/r/<code>) and the template URL buttons.
APP_URL=https://your-app.vercel.app

# ---------- Kapso / WhatsApp
KAPSO_API_BASE_URL=https://api.kapso.ai
KAPSO_API_KEY=
# Your connected number (+1 711-262-6471) and its WhatsApp Business Account
KAPSO_PHONE_NUMBER_ID=1347369521796708
KAPSO_WABA_ID=1626288265568713
# Secret Kapso returns when you create the phone-number webhook (npm run webhook:register)
KAPSO_WEBHOOK_SECRET=
META_GRAPH_VERSION=v24.0

# ---------- Google Sheets database (apps-script/Code.gs deployed as a web app)
# The /exec URL from Deploy → Manage deployments in the Apps Script editor
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXX/exec
# Same value as the API_SECRET script property (32+ random characters)
APPS_SCRIPT_SECRET=

# ---------- Admin dashboard
# Generate with: npm run hash-password -- "your-strong-password"
ADMIN_PASSWORD_HASH=
# Any long random string (32+ chars), e.g. from: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Salt for hashing phone numbers in the suppression list (32+ random chars, never change it later)
PHONE_HASH_SALT=

# ---------- Alerts for human handoff / hot leads
# Ammar's WhatsApp, digits only with country code
ADMIN_WHATSAPP=918866475352
# Optional email alerts through Resend (https://resend.com)
RESEND_API_KEY=
ALERT_EMAIL_TO=ammar@ahg53.bond
ALERT_EMAIL_FROM=AHG53 Bot <bot@ahg53.bond>

# ---------- Optional AI replies (Claude API)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# ---------- Cron (Vercel sends this automatically as a Bearer token when set)
CRON_SECRET=

# ---------- Website opt-in form (comma-separated origins allowed to POST /api/optin)
OPTIN_ALLOWED_ORIGINS=https://ahg53.bond,https://www.ahg53.bond
